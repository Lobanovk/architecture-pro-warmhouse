@startuml
title WarmHouse To-Be Context Diagram

top to bottom direction

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(user, "Пользователь", "Самостоятельно подключает устройства, управляет ими, настраивает сценарии, смотрит телеметрию и видео")
Person(admin, "Администратор", "Смотрит статистику по подключенным домам, управляет пользователями")

System(WarmHouse, "Теплый дом", "SaaS-платформа управления умным домом")

System_Ext(devices, "Умные устройства партнеров", "Датчики, реле, освещение, ворота, камеры. Подключаются по стандартным протоколам")

Rel(user, WarmHouse, "Подключает устройства, управляет ими, настраивает сценарии, смотрит телеметрию")
Rel(admin, WarmHouse, "Запрашивает статистику, управляет пользователями и ролями")

Rel(devices, WarmHouse, "Отправляют телеметрию и состояние, получают команды")

@enduml
